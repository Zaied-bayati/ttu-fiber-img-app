<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Ttu.FiberImgApp.Pages.CapturePage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Ttu.FiberImgApp.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer Padding="20">
        <StackPanel Spacing="16" MaxWidth="1100">
            <TextBlock Text="Capture" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasBanner, Mode=OneWay}"
                Severity="Warning"
                Message="{x:Bind ViewModel.BannerMessage, Mode=OneWay}"
                IsClosable="True" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="#1A1F2E" CornerRadius="8" MinHeight="320" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Image
                            Source="{x:Bind ViewModel.PreviewImage, Mode=OneWay}"
                            Stretch="Uniform"
                            DoubleTapped="Preview_DoubleTapped" />
                        <StackPanel
                            x:Name="PlaceholderOverlay"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="4"
                            Visibility="Collapsed">
                            <TextBlock Foreground="White" Opacity="0.9" FontSize="18" TextAlignment="Center" Text="Live preview" />
                            <TextBlock Foreground="White" Opacity="0.7" TextAlignment="Center" Text="Connect camera and start live" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Spacing="10">
                    <TextBlock Text="Camera (Zeiss / simulator)" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.CameraStatus, Mode=OneWay}" Opacity="0.8" TextWrapping="WrapWholeWords" />
                    <Button Content="Connect camera" Command="{x:Bind ViewModel.ConnectCameraCommand}" HorizontalAlignment="Stretch" />
                    <Button Content="Start live" Command="{x:Bind ViewModel.StartLiveCommand}" HorizontalAlignment="Stretch" />
                    <Button Content="Stop live" Command="{x:Bind ViewModel.StopLiveCommand}" HorizontalAlignment="Stretch" />
                    <Button Content="Fullscreen live" Command="{x:Bind ViewModel.OpenLiveFullscreenCommand}" HorizontalAlignment="Stretch" />

                    <TextBlock Margin="0,12,0,0" Text="Stage" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.StageStatus, Mode=OneWay}" TextWrapping="WrapWholeWords" />

                    <Button Content="Connect stage" Command="{x:Bind ViewModel.ConnectStageCommand}" HorizontalAlignment="Stretch" />
                    <Button Content="Home stage" Command="{x:Bind ViewModel.HomeStageCommand}" HorizontalAlignment="Stretch" />

                    <TextBlock Margin="0,12,0,0" Text="Sampling" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="How many images?" />
                    <NumberBox
                        Value="{x:Bind ViewModel.ImageCount, Mode=TwoWay}"
                        Minimum="2"
                        Maximum="500"
                        SpinButtonPlacementMode="Inline" />
                    <TextBlock Text="{x:Bind ViewModel.SpacingSummary, Mode=OneWay}" TextWrapping="WrapWholeWords" Opacity="0.85" />

                    <Button
                        Content="Begin Sampling"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.BeginSamplingCommand}"
                        HorizontalAlignment="Stretch" />
                    <Button Content="Cancel" Command="{x:Bind ViewModel.CancelSamplingCommand}" HorizontalAlignment="Stretch" />

                    <TextBlock Text="{x:Bind ViewModel.ProgressMessage, Mode=OneWay}" TextWrapping="WrapWholeWords" Margin="0,8,0,0" />
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>

            <StackPanel Spacing="12" x:Name="ReviewPanel">
                <TextBlock Text="Review images" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Double-click an image to fullscreen (scroll wheel / buttons to zoom). Delete any you do not want, then save." TextWrapping="WrapWholeWords" Opacity="0.8" />

                <GridView x:Name="ReviewGrid" ItemsSource="{x:Bind ViewModel.ReviewImages, Mode=OneWay}" SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReviewImageItem">
                            <Border
                                Width="180"
                                Padding="8"
                                Margin="4"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                DoubleTapped="ReviewItem_DoubleTapped"
                                Tag="{x:Bind}">
                                <StackPanel Spacing="6">
                                    <Image Source="{x:Bind Thumbnail}" Height="100" Stretch="UniformToFill" />
                                    <TextBlock Text="{x:Bind Caption}" TextWrapping="Wrap" />
                                    <Button Content="Delete" Click="DeleteImage_Click" Tag="{x:Bind}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Save session to folder" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveSessionCommand}" />
                    <Button Content="Discard session" Command="{x:Bind ViewModel.DiscardSessionCommand}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>